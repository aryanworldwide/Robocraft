rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each student can read and write only their own progress.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // AI-generated projects: anyone can read (shared cache); signed-in users can
    // add new ones and update only their own.
    match /generatedProjects/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null && resource.data.owner == request.auth.uid;
      allow delete: if false;
    }
  }
}
