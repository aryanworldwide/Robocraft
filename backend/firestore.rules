rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each student can read and write only their own progress.
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      // XP and streaks are a local game score, not a security boundary — a
      // student editing their own number only fools themselves. What this does
      // stop is the document being used as free storage for arbitrary data.
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().size() <= 40
        && request.resource.size() < 900000;
    }
    // Weekly leaderboard: nickname, avatar emoji, class and weekly XP only.
    // Signed-in students can read it; each student writes only their own entry.
    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nickname', 'avatar', 'classId', 'board', 'weekXp', 'group', 'hidden', 'updated'])
        && request.resource.data.nickname is string && request.resource.data.nickname.matches('^[A-Za-z0-9_ ]{3,16}$')
        && request.resource.data.avatar is string && request.resource.data.avatar.size() <= 8
        && request.resource.data.classId in ['class_9', 'class_10', 'class_11']
        && request.resource.data.board is string && request.resource.data.board.size() <= 40
        && request.resource.data.weekXp is int && request.resource.data.weekXp >= 0 && request.resource.data.weekXp <= 50000
        && request.resource.data.group is string && request.resource.data.group.matches('^[A-Z0-9]{0,12}$')
        && request.resource.data.hidden is bool
        && request.resource.data.updated is string;
    }
    // "Report a problem" (content mistakes, AI replies). Write-only for students.
    match /reports/{id} {
      allow read, update, delete: if false;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['kind', 'message', 'page', 'lessonId', 'excerpt', 'classId', 'app', 'created', 'uid'])
        && request.resource.data.message is string && request.resource.data.message.size() <= 1000
        && request.resource.data.excerpt is string && request.resource.data.excerpt.size() <= 1500;
    }
    // AI-generated projects. These documents are written straight from the
    // browser with the public Firebase config, so they are PRIVATE to the
    // student who made them: sharing the cache between accounts would let
    // anyone put arbitrary text in front of another child. The shape is
    // pinned so a malformed document cannot break the screen either.
    match /generatedProjects/{id} {
      allow read, update, delete: if request.auth != null && resource.data.owner == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['owner', 'user_prompt', 'project_name', 'project_data', 'difficulty', 'created_date'])
        && request.resource.data.user_prompt is string && request.resource.data.user_prompt.size() <= 300
        && request.resource.data.project_name is string && request.resource.data.project_name.size() <= 150
        && request.resource.data.project_data is map
        && request.resource.data.created_date is string && request.resource.data.created_date.size() <= 40;
    }
  }
}
